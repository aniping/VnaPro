cmake_minimum_required(VERSION 3.16)
if(NOT DEFINED INPUT OR NOT EXISTS "${INPUT}")
    message(FATAL_ERROR "VnaPro release input is missing")
endif()
include("${INPUT}")
if(BUNDLE_DIRECTORY STREQUAL "")
    message(FATAL_ERROR "Release directory cannot be empty")
endif()
get_filename_component(BUNDLE_DIRECTORY "${BUNDLE_DIRECTORY}" ABSOLUTE)
get_filename_component(binary_directory "${BUNDLE_EXECUTABLE}" DIRECTORY)
get_filename_component(parent_directory "${BUNDLE_DIRECTORY}" DIRECTORY)
if(BUNDLE_DIRECTORY STREQUAL binary_directory OR BUNDLE_DIRECTORY STREQUAL parent_directory OR
    BUNDLE_DIRECTORY STREQUAL BUNDLE_SOURCE_DIRECTORY OR BUNDLE_DIRECTORY STREQUAL BUNDLE_BUILD_DIRECTORY)
    message(FATAL_ERROR "Release directory must be separate from binary files")
endif()
# 发布目录不能落入前端输入目录，避免重复构建将上一份发布包再次递归复制。
get_filename_component(web_real_directory "${BUNDLE_WEBUI}" REALPATH)
get_filename_component(output_real_directory "${BUNDLE_DIRECTORY}" REALPATH)
file(RELATIVE_PATH web_relative "${web_real_directory}" "${output_real_directory}")
if(NOT IS_ABSOLUTE "${web_relative}" AND NOT web_relative MATCHES "(^|[/\\])\\.\\.([/\\]|$)")
    message(FATAL_ERROR "Release directory cannot be inside WebUI input directory")
endif()
if(BUNDLE_INCLUDE_WEBUI)
    # 与前端生成共用锁，避免另一个构建树在复制途中清空 dist。
    get_filename_component(web_directory "${BUNDLE_WEBUI}" DIRECTORY)
    file(LOCK "${web_directory}/.vnapro-build.lock" GUARD PROCESS TIMEOUT 60
        RESULT_VARIABLE lock_result)
    if(NOT lock_result STREQUAL "0")
        message(FATAL_ERROR "Cannot acquire WebUI packaging lock: ${lock_result}")
    endif()
endif()
if(BUNDLE_INCLUDE_WEBUI AND NOT EXISTS "${BUNDLE_WEBUI}/index.html")
    message(FATAL_ERROR "WebUI build did not produce dist/index.html. Build vna_server again, or set VNAPRO_BUNDLE_WEBUI=OFF for a SCPI-only bundle")
endif()
file(MAKE_DIRECTORY "${BUNDLE_DIRECTORY}")
get_filename_component(release_real_directory "${BUNDLE_DIRECTORY}" REALPATH)
set(managed_files "")

function(check_release_path path)
    get_filename_component(directory "${path}" DIRECTORY)
    get_filename_component(real_directory "${directory}" REALPATH)
    file(RELATIVE_PATH relative "${release_real_directory}" "${real_directory}")
    if(IS_ABSOLUTE "${relative}" OR relative MATCHES "(^|[/\\])\\.\\.([/\\]|$)" OR IS_SYMLINK "${path}")
        message(FATAL_ERROR "Release file escapes the selected directory: ${path}")
    endif()
endfunction()

function(copy_release_file source relative)
    if(NOT EXISTS "${source}" OR IS_DIRECTORY "${source}")
        message(FATAL_ERROR "Required release file is missing: ${source}")
    endif()
    get_filename_component(directory "${BUNDLE_DIRECTORY}/${relative}" DIRECTORY)
    file(MAKE_DIRECTORY "${directory}")
    check_release_path("${BUNDLE_DIRECTORY}/${relative}")
    execute_process(COMMAND "${CMAKE_COMMAND}" -E copy_if_different
        "${source}" "${BUNDLE_DIRECTORY}/${relative}" RESULT_VARIABLE result)
    if(NOT result EQUAL 0)
        message(FATAL_ERROR "Cannot update release file: ${relative}. Close processes using this release directory")
    endif()
    set(managed_files ${managed_files} "${relative}" PARENT_SCOPE)
endfunction()

copy_release_file("${BUNDLE_CONFIG}" "vnapro.example.yml")
copy_release_file("${BUNDLE_SPDLOG_LICENSE}" "licenses/spdlog.txt")
copy_release_file("${BUNDLE_YAML_LICENSE}" "licenses/yaml-cpp.txt")
# 发布环境可以独立调整仪器和日志配置，重复构建不覆盖这些修改。
if(NOT EXISTS "${BUNDLE_DIRECTORY}/vnapro.yml")
    copy_release_file("${BUNDLE_CONFIG}" "vnapro.yml")
else()
    list(APPEND managed_files "vnapro.yml")
endif()
if(BUNDLE_INCLUDE_WEBUI)
    file(GLOB_RECURSE web_files LIST_DIRECTORIES FALSE RELATIVE "${BUNDLE_WEBUI}" "${BUNDLE_WEBUI}/*")
    foreach(relative IN LISTS web_files)
        copy_release_file("${BUNDLE_WEBUI}/${relative}" "WebUI/${relative}")
    endforeach()
endif()
foreach(driver IN LISTS BUNDLE_DRIVERS)
    get_filename_component(name "${driver}" NAME)
    copy_release_file("${driver}" "${name}")
endforeach()
foreach(runtime IN LISTS BUNDLE_EXTRA_RUNTIME)
    get_filename_component(name "${runtime}" NAME)
    copy_release_file("${runtime}" "${name}")
endforeach()

set(executables "")
if(EXISTS "${BUNDLE_EXECUTABLE}")
    list(APPEND executables "${BUNDLE_EXECUTABLE}")
    get_filename_component(name "${BUNDLE_EXECUTABLE}" NAME)
    copy_release_file("${BUNDLE_EXECUTABLE}" "${name}")
elseif(PHASE STREQUAL "complete")
    message(FATAL_ERROR "Built VnaPro executable is missing")
endif()
if(CMAKE_GET_RUNTIME_DEPENDENCIES_PLATFORM STREQUAL "windows+pe")
    set(pre_exclude "^[Aa][Pp][Ii]-[Mm][Ss]-.*" "^[Ee][Xx][Tt]-[Mm][Ss]-.*")
    # VC 运行库已经由工具链明确提供；Windows 自带 DLL 无需随包复制。
    set(post_exclude ".*[/\\][Ss][Yy][Ss][Tt][Ee][Mm]32[/\\].*" ".*[/\\][Ss][Yy][Ss][Ww][Oo][Ww]64[/\\].*")
elseif(CMAKE_GET_RUNTIME_DEPENDENCIES_PLATFORM STREQUAL "macos+macho")
    set(pre_exclude "")
    set(post_exclude "^/System/Library/.*" "^/usr/lib/.*")
else()
    set(pre_exclude "")
    set(post_exclude ".*/ld-linux.*" ".*/lib(c|m|pthread|dl|rt|resolv|util|nsl)\\.so(\\..*)?")
endif()
file(GET_RUNTIME_DEPENDENCIES
    EXECUTABLES ${executables}
    LIBRARIES ${BUNDLE_DRIVERS} ${BUNDLE_EXTRA_RUNTIME}
    DIRECTORIES ${BUNDLE_RUNTIME_DIRECTORIES}
    RESOLVED_DEPENDENCIES_VAR dependencies
    UNRESOLVED_DEPENDENCIES_VAR unresolved
    CONFLICTING_DEPENDENCIES_PREFIX conflicts
    PRE_EXCLUDE_REGEXES ${pre_exclude}
    POST_EXCLUDE_REGEXES ${post_exclude})
if(unresolved OR conflicts_FILENAMES)
    message(FATAL_ERROR "Runtime dependencies cannot be bundled: missing=${unresolved}; conflicts=${conflicts_FILENAMES}")
endif()
foreach(dependency IN LISTS dependencies)
    get_filename_component(name "${dependency}" NAME)
    copy_release_file("${dependency}" "${name}")
endforeach()

# 只移除上次清单管理的旧文件，日志和未列入清单的用户文件始终保留。
set(manifest "${BUNDLE_DIRECTORY}/.vnapro-release-files")
if(EXISTS "${manifest}")
    file(STRINGS "${manifest}" previous_files ENCODING UTF-8)
    foreach(relative IN LISTS previous_files)
        if(IS_ABSOLUTE "${relative}" OR relative MATCHES "(^|[/\\])\\.\\.([/\\]|$)")
            message(FATAL_ERROR "Invalid path in release manifest: ${relative}")
        endif()
        if(NOT relative IN_LIST managed_files AND NOT IS_DIRECTORY "${BUNDLE_DIRECTORY}/${relative}")
            check_release_path("${BUNDLE_DIRECTORY}/${relative}")
            file(REMOVE "${BUNDLE_DIRECTORY}/${relative}")
        endif()
    endforeach()
endif()
if(executables)
    list(REMOVE_DUPLICATES managed_files)
    list(SORT managed_files)
    string(REPLACE ";" "\n" contents "${managed_files}")
    file(WRITE "${manifest}" "${contents}\n")
endif()
if(PHASE STREQUAL "complete")
    message(STATUS "VnaPro release ready: ${BUNDLE_DIRECTORY}")
else()
    message(STATUS "VnaPro release resources synchronized: ${BUNDLE_DIRECTORY}")
endif()
