# 由 CMake 按构建配置生成；源路径不会写入发布清单。
set(BUNDLE_DIRECTORY [==[@VNAPRO_RELEASE_OUTPUT@]==])
set(BUNDLE_SOURCE_DIRECTORY [==[@CMAKE_SOURCE_DIR@]==])
set(BUNDLE_BUILD_DIRECTORY [==[@CMAKE_BINARY_DIR@]==])
set(BUNDLE_EXECUTABLE [==[@VNAPRO_RELEASE_EXECUTABLE@]==])
set(BUNDLE_DRIVERS [==[@VNAPRO_RELEASE_DRIVERS@]==])
set(BUNDLE_CONFIG [==[@CMAKE_SOURCE_DIR@/config/vnapro.yml]==])
set(BUNDLE_WEBUI [==[@CMAKE_SOURCE_DIR@/WebUI/dist]==])
set(BUNDLE_INCLUDE_WEBUI @VNAPRO_BUNDLE_WEBUI@)
set(BUNDLE_RUNTIME_DIRECTORIES [==[@VNAPRO_RUNTIME_DIRECTORIES@]==])
set(BUNDLE_EXTRA_RUNTIME [==[@VNAPRO_RUNTIME_EXTRA_FILES@]==])
set(BUNDLE_SPDLOG_LICENSE [==[@VNAPRO_SPDLOG_SOURCE_DIR@/LICENSE]==])
set(BUNDLE_YAML_LICENSE [==[@VNAPRO_YAML_CPP_SOURCE_DIR@/LICENSE]==])
set(CMAKE_GET_RUNTIME_DEPENDENCIES_PLATFORM [==[@VNAPRO_DEPENDENCY_PLATFORM@]==])
set(CMAKE_GET_RUNTIME_DEPENDENCIES_TOOL [==[@VNAPRO_DEPENDENCY_TOOL@]==])
set(CMAKE_GET_RUNTIME_DEPENDENCIES_COMMAND [==[@VNAPRO_DEPENDENCY_COMMAND@]==])
